# GymCrest API settings as environment variables (the format Docker and Render use).
# Copy to .env for `docker run --env-file .env`; never commit the real .env.
# For `dotnet run`, put the same values in GymForge.Api/appsettings.Development.json instead
# ("__" here = nesting there, e.g. Jwt__Key -> { "Jwt": { "Key": ... } }).

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL. The API also accepts a postgresql://user:password@host:5432/db URL here
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=gymcrest;Username=postgres;Password=yourpassword

# At least 32 characters
Jwt__Key=replace-with-a-random-secret-of-at-least-32-characters
Jwt__Issuer=GymCrestAPI
Jwt__Audience=GymCrestClient

# Frontend address: used in emailed links and allowed by CORS
GymCrest__BaseUrl=http://localhost:4200

# Brevo transactional email (HTTP API key + template IDs from your Brevo account)
Brevo__RestApiKey=
Brevo__FromEmail=
Brevo__FromName=GymCrest
Brevo__Templates__Invitation=
Brevo__Templates__VerificationCode=
Brevo__Templates__PasswordReset=
Brevo__Templates__SaleReceipt=
Brevo__Templates__MembershipLinked=
Brevo__Templates__PlanExpired=
Brevo__Templates__MembershipNotice=

# Razorpay (GymCrest's own SaaS billing)
RazorPay__ApiKeyId=
RazorPay__ApiKeySecret=

# Cloudinary image uploads
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
